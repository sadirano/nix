# zig fmt only accepts LF. GitHub's Windows runners ship core.autocrlf=true,
# which would check sources out as CRLF and fail the CI format gate.
*.zig text eol=lf
*.zon text eol=lf

# Shell scripts are run by sh/bash; CRLF makes the shebang line unusable.
.githooks/* text eol=lf
.github/scripts/* text eol=lf
